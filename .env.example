NODE_ENV=development
PUBLIC_URL=http://localhost:3080
LISTEN_HOST=127.0.0.1
# Only explicitly trusted reverse proxies may set the client IP for rate limits.
TRUSTED_PROXY_CIDRS=
PORT=3080
DATABASE_PATH=./data/connector.sqlite
# Generate with: openssl rand -base64 32. Prefer MASTER_KEY_FILE in production.
MASTER_KEY=
# MASTER_KEY_FILE=/run/secrets/master_key
# Explicit network allowlist. Prefer individual /32 or /128 entries.
SSH_ALLOWED_CIDRS=10.20.0.0/24
# Exact OAuth callbacks; copy the callback displayed by your GPT client.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
REQUIRE_MFA=true
# Refreshed automatically by the MCP client; inactivity, revocation or account changes can require sign-in again.
OAUTH_REFRESH_IDLE_DAYS=90
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=60
OUTPUT_LIMIT_BYTES=65536
RETENTION_DAYS=30
