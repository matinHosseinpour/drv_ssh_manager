# Managed by Server Connector installer. Do not edit; rerun script.sh.
server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/server-connector.error.log crit;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/server-connector/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://@@DOMAIN@@$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/server-connector.error.log crit;
    client_max_body_size 100k;

    ssl_certificate /etc/letsencrypt/live/server-connector-@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server-connector-@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:ConnectorTLS:10m;
    ssl_session_timeout 1d;

    # Keep the original request path for /mcp, /oauth/*, /.well-known/* and the UI.
    location / {
        proxy_pass http://127.0.0.1:@@PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite user-supplied forwarding headers at the sole public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_hide_header X-Powered-By;
    }
}
